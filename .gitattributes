# CAD binaries via Git LFS. Set up BEFORE any land: retrofitting LFS means
# rewriting published history, and GitHub hard-rejects any file over 100 MB.
# These patterns are inert until a matching file is committed.
*.f3d  filter=lfs diff=lfs merge=lfs -text
*.f3z  filter=lfs diff=lfs merge=lfs -text
*.stl  filter=lfs diff=lfs merge=lfs -text
*.STL  filter=lfs diff=lfs merge=lfs -text
*.3mf  filter=lfs diff=lfs merge=lfs -text

# STEP is ASCII (ISO 10303-21), so keep it in plain git where it diffs and greps.
# It is also the only format in here a contributor can open without a Fusion licence.
*.step text
*.stp  text

# Shell scripts keep LF regardless of platform.
*.sh text eol=lf
